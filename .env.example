# MOCK_MODE=false → live Claude API (requires ANTHROPIC_API_KEY and billing)
# PROMPT_CACHE=true → reuse cached council instructions across API calls (default)
# TOKEN_BUDGET=600000 → daily token cap (UTC day).
MOCK_MODE=true
PROMPT_CACHE=true
TOKEN_BUDGET=600000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
APP_BASE_URL=https://inthistimebefore.onrender.com
# Render persistent disk mount. Local default can remain transcripts/.
TRANSCRIPT_DIR=transcripts
# COUNCIL_ROSTER=arabi,morrison,kierkegaard  (exactly 3; blake available as backup)
COUNCIL_ROSTER=arabi,morrison,kierkegaard
